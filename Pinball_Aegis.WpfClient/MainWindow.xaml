<ui:FluentWindow x:Class="Pinball_Aegis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Pinball_Aegis"
        mc:Ignorable="d"
        Title="Pinball Aegis - Opérations de Sécurité &amp; Flipper" 
        Height="760" Width="1240"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar customisée WPF-UI -->
        <ui:TitleBar Grid.Row="0" Title="Pinball Aegis" ShowMaximize="True" ShowMinimize="True"/>

        <!-- Layout Principal : Navigation latérale + Contenu -->
        <ui:NavigationView Grid.Row="1" x:Name="RootNavigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed">
            
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Attestation TPM" 
                                       Icon="{ui:SymbolIcon ShieldCheckmark24}" 
                                       TargetPageType="{x:Type local:Views.MachineAttestationView}" />
            </ui:NavigationView.MenuItems>

            <!-- Profil Opérateur dans le Footer de la Sidebar -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{Binding OperatorDisplayName}" 
                                       Icon="{ui:SymbolIcon Person24}"
                                       Command="{Binding ToggleLoginDrawerCommand}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>

        <!-- Tiroir / Drawer d'authentification opérateur au-dessus du footer -->
        <Border Grid.Row="1" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom"
                Margin="12,0,0,60" 
                Width="320"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Panel.ZIndex="1000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoginDrawerOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <!-- Formulaire quand NON connecté -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Authentification Opérateur" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="Protocole Zero-Trust OIDC avec PKCE (S256). Saisie sécurisée sur Keycloak." 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="11" 
                               TextWrapping="Wrap" 
                               Margin="0,0,0,12"/>

                    <ui:Button Content="S'identifier avec Keycloak" 
                               Command="{Binding LoginCommand}" 
                               Appearance="Primary" 
                               Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding LoginStatus}" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               FontSize="11" 
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Statut & Déconnexion quand CONNECTÉ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Session Active" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding OperatorDisplayName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <ui:Button Content="Se déconnecter" 
                               Command="{Binding LogoutCommand}" 
                               Appearance="Secondary" 
                               HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>

</ui:FluentWindow>
