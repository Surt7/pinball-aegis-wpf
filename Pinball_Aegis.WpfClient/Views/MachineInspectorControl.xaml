<UserControl x:Class="Pinball_Aegis.Views.MachineInspectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewmodels="clr-namespace:Pinball_Aegis.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MachineAttestationViewModel}">

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
            BorderThickness="1" 
            CornerRadius="8" 
            Padding="16">
        <Grid>
            <!-- Empty state: when no machine is selected -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMachine}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:SymbolIcon Symbol="DesktopCheckmark24" FontSize="40" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Sélectionnez un flipper dans la liste" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock Text="pour inspecter son certificat matériel et son attestation TPM." Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Details state: when a machine is selected -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMachine}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <StackPanel>
                    <!-- Machine header with quick copy button -->
                    <DockPanel LastChildFill="True" Margin="0,0,0,2">
                        <ui:Button DockPanel.Dock="Right" 
                                   Icon="{ui:SymbolIcon Copy16}" 
                                   Appearance="Transparent" 
                                   Padding="4" 
                                   ToolTip="Copier le nom du flipper" 
                                   Command="{Binding CopyNameCommand}" 
                                   CommandParameter="{Binding SelectedMachine.DisplayName}"/>
                        <TextBlock Text="{Binding SelectedMachine.DisplayName}" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding SelectedMachine.MachineName}" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>

                    <!-- Machine status badge -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="8,4" 
                            HorizontalAlignment="Left" 
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedMachine.StatusText}" 
                                   Foreground="{Binding SelectedMachine.StatusColor}" 
                                   FontWeight="SemiBold" 
                                   FontSize="12"/>
                    </Border>

                    <!-- Inventory data card -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Serial number with copy and filter actions -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="N° de Série :" Foreground="#94A3B8" FontSize="11" Margin="0,4"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedMachine.SerialNumber}" 
                                           FontFamily="Consolas, monospace" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Foreground="#93C5FD" 
                                           VerticalAlignment="Center"/>
                                <ui:Button Icon="{ui:SymbolIcon Copy16}" 
                                           Appearance="Transparent" 
                                           Padding="3" 
                                           Margin="6,0,0,0" 
                                           ToolTip="Copier ce numéro de série" 
                                           Command="{Binding CopySerialCommand}" 
                                           CommandParameter="{Binding SelectedMachine.SerialNumber}"/>
                                <ui:Button Icon="{ui:SymbolIcon Filter20}" 
                                           Appearance="Transparent" 
                                           Padding="3" 
                                           Margin="2,0,0,0" 
                                           ToolTip="Filtrer la recherche avec ce numéro" 
                                           Command="{Binding FilterBySerialCommand}" 
                                           CommandParameter="{Binding SelectedMachine.SerialNumber}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Enregistré le :" Foreground="#94A3B8" FontSize="11" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedMachine.RegisteredAtUtc, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#E2E8F0" FontSize="11" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Dernière MàJ :" Foreground="#94A3B8" FontSize="11" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedMachine.LastUpdated, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#E2E8F0" FontSize="11" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Notes :" Foreground="#94A3B8" FontSize="11" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedMachine.MachineNotes}" Foreground="#CBD5E1" FontSize="11" Margin="0,4" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- SECTION 1: LIVE TPM CRYPTOGRAPHIC ATTESTATION -->
                    <TextBlock Text="Attestation Cryptographique TPM" FontWeight="SemiBold" FontSize="13" Foreground="#F8FAFC" Margin="0,0,0,6"/>
                    <TextBlock Text="Contrôle l'identité mTLS de la machine et la validité de son certificat matériel." Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <ui:Button Content="Vérifier l'Attestation TPM" 
                               Icon="{ui:SymbolIcon ShieldCheckmark24}" 
                               Appearance="Primary" 
                               HorizontalAlignment="Stretch"
                               Command="{Binding VerifySelectedMachineCommand}"
                               IsEnabled="{Binding CanVerifyTpm}"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding AttestationStatus}" 
                               FontSize="11" 
                               FontWeight="SemiBold"
                               Foreground="#E2E8F0"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Hardware certificate details card (if present) -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10" 
                            Margin="0,0,0,16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSecurityDetails}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Certificat Matériel TPM (Step-CA)" FontWeight="SemiBold" FontSize="11" Foreground="#93C5FD" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="N° Certificat :" Foreground="#94A3B8" FontSize="10" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SecurityDetails.CertSerialNumber}" FontFamily="Consolas, monospace" FontWeight="SemiBold" Foreground="#F8FAFC" FontSize="10" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Émetteur CA :" Foreground="#94A3B8" FontSize="10" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SecurityDetails.IssuerDn}" Foreground="#E2E8F0" FontSize="10" Margin="0,2" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Puce Matériel :" Foreground="#94A3B8" FontSize="10" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SecurityDetails.DevicePhysicalSerial}" Foreground="#E2E8F0" FontSize="10" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Expiration :" Foreground="#94A3B8" FontSize="10" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SecurityDetails.NotAfterUtc, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#E2E8F0" FontSize="10" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Empreinte :" Foreground="#94A3B8" FontSize="10" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SecurityDetails.CertThumbprintSha256}" FontFamily="Consolas, monospace" Foreground="#94A3B8" FontSize="9" Margin="0,2" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: LIFECYCLE & TOKEN ENROLLMENT/REISSUE -->
                    <TextBlock Text="Cycle de Vie &amp; Enrôlement" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock Text="Permet d'émettre un jeton pour le technicien terrain (client Qt)." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <ui:Button Content="{Binding ReissueButtonText}" 
                               Icon="{ui:SymbolIcon Key24}" 
                               Appearance="Secondary" 
                               HorizontalAlignment="Stretch"
                               Command="{Binding ReissueTokenCommand}"
                               IsEnabled="{Binding CanReissueToken}"
                               Margin="0,0,0,10"/>

                    <!-- Generated/Reissued token display card -->
                    <Border Background="#1A2E1A" BorderBrush="#51CF66" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTokenReissued}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Nouveau Jeton d'Enrôlement :" FontWeight="SemiBold" Foreground="#51CF66" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ReissuedToken, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     FontFamily="Consolas, monospace" 
                                     FontSize="11" 
                                     Background="#0F172A" 
                                     Foreground="#F8FAFC"
                                     Padding="6" 
                                     Margin="0,0,0,6"/>
                            <ui:Button Content="Copier le Jeton" 
                                       Icon="{ui:SymbolIcon Copy24}" 
                                       Appearance="Transparent" 
                                       Command="{Binding CopyTokenToClipboardCommand}" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
