<Page x:Class="Pinball_Aegis.Views.MachineAttestationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Pinball_Aegis.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <!-- Main Workspace (Column 1) -->
    <Grid Grid.Column="1" Margin="25">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="450">
                
            <!-- Modern card containing machine controls -->
            <ui:Card Margin="0,0,0,15" Padding="20">
                <StackPanel>
                    <TextBlock Text="Identifiant de la Machine ciblée :" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,0,0,8"/>

                    <!-- Two-Way Binding: every keystroke updates the ViewModel -->
                    <ui:TextBox Text="{Binding TargetMachineId, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="Ex: NUC-FLIPPER-042"
                                Icon="{ui:SymbolIcon Desktop24}"
                                Margin="0,0,0,15"/>

                    <!-- Button to badge in as technician -->
                    <ui:Button Content="Badger en tant que Technicien" 
                               Command="{Binding LoginAsTechnicianCommand}" 
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon PersonKey24}"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,10"/>

                    <!-- Action button protected by RBAC permission -->
                    <ui:Button Content="Vérifier l'Attestation TPM" 
                               Command="{Binding VerifyMachineIdentityCommand}" 
                               IsEnabled="{Binding CanVerifyTpm}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ui:Card>

            <!-- Status TextBlock updating in real-time -->
            <TextBlock Text="{Binding ConnectionStatus}" 
                       FontSize="15" 
                       FontWeight="Medium" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>
                           
        </StackPanel>
    </Grid>
</Page>
