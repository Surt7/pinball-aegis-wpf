<Page x:Class="Pinball_Aegis.Views.MachineAttestationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="600">

    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">

            <!-- Card: Machine TPM Verification -->
            <ui:Card Margin="0,0,0,15" Padding="25">
                <StackPanel>
                    
                    <TextBlock Text="Attestation Matérielle &amp; Sécurité TPM" 
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>

                    <TextBlock Text="Identifiant de la Machine ciblée (Flipper) :" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               Margin="0,0,0,8"/>

                    <!-- Two-Way Binding on Target Machine ID -->
                    <ui:TextBox Text="{Binding TargetMachineId, UpdateSourceTrigger=PropertyChanged}" 
                                PlaceholderText="Ex: NUC-FLIPPER-042"
                                Icon="{ui:SymbolIcon Desktop24}"
                                Margin="0,0,0,15"/>

                    <!-- Operator Authorization Status Banner -->
                    <Border Margin="0,0,0,15" Padding="12,10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding OperatorStatusText}" 
                                       FontSize="12" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Primary Action Button: Protected by RBAC permission -->
                    <ui:Button Content="Vérifier l'Attestation TPM" 
                               Command="{Binding VerifyMachineIdentityCommand}" 
                               IsEnabled="{Binding CanVerifyTpm}"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon ShieldCheckmark24}"
                               HorizontalAlignment="Stretch"
                               Height="38"/>
                </StackPanel>
            </ui:Card>

            <!-- Result status text block -->
            <TextBlock Text="{Binding ConnectionStatus}" 
                       FontSize="14" 
                       FontWeight="Medium" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

        </StackPanel>
    </Grid>
</Page>
