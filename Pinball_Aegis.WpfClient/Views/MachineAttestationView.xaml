<Page x:Class="Pinball_Aegis.Views.MachineAttestationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:Pinball_Aegis.Views"
      xmlns:viewmodels="clr-namespace:Pinball_Aegis.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="Supervision Flotte &amp; Sécurité TPM"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: Title and filters / search bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Context -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Supervision de Flotte &amp; Sécurité TPM" 
                           FontSize="22" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,4"/>
                <TextBlock Text="Inventaire centralisé des flippers, état des certificats et vérification matérielle TPM." 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                           FontSize="12"/>
            </StackPanel>

            <!-- Toolbar: Search, Status filter, Refresh -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                            PlaceholderText="Rechercher machine, série..." 
                            Icon="{ui:SymbolIcon Search24}"
                            Width="220" 
                            Margin="0,0,8,0"/>

                <ComboBox SelectedValue="{Binding SelectedStatusFilter}" 
                          SelectedValuePath="Content"
                          Width="160" 
                          Margin="0,0,8,0">
                    <ComboBoxItem Content="Tous" IsSelected="True"/>
                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="En attente d'enrôlement"/>
                    <ComboBoxItem Content="Maintenance"/>
                    <ComboBoxItem Content="Inactive"/>
                    <ComboBoxItem Content="Révoquée"/>
                </ComboBox>

                <ui:Button Content="Actualiser" 
                           Icon="{ui:SymbolIcon ArrowSync24}" 
                           Command="{Binding LoadMachinesCommand}"/>
            </StackPanel>
        </Grid>

        <!-- MAIN BODY: Inventory table (Left) + Machine details inspector (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="1.7*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Flipper inventory (Modern DataGrid) -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="8"
                    Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding FilteredMachines}" 
                              SelectedItem="{Binding SelectedMachine}" 
                              AutoGenerateColumns="False" 
                              CanUserAddRows="False" 
                              IsReadOnly="True" 
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="42"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">

                    <!-- Column headers style -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Row style & Context menu -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#F8FAFC"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Copier le N° de série" 
                                                  Command="{Binding DataContext.CopySerialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                  CommandParameter="{Binding SerialNumber}"/>
                                        <MenuItem Header="Copier le Nom du flipper" 
                                                  Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                  CommandParameter="{Binding DisplayName}"/>
                                        <Separator/>
                                        <MenuItem Header="Filtrer sur cette machine" 
                                                  Command="{Binding DataContext.FilterBySerialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                  CommandParameter="{Binding SerialNumber}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Machine / Flipper Name -->
                        <DataGridTemplateColumn Header="Flipper" Width="2.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Tv24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC"/>
                                            <TextBlock Text="{Binding MachineName}" Foreground="#94A3B8" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Serial Number (With copy button) -->
                        <DataGridTemplateColumn Header="N° de Série" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4">
                                        <TextBlock Text="{Binding SerialNumber}" 
                                                   FontFamily="Consolas, monospace" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="11" 
                                                   Foreground="#93C5FD" 
                                                   VerticalAlignment="Center"/>
                                        <ui:Button Icon="{ui:SymbolIcon Copy16}" 
                                                   Appearance="Transparent" 
                                                   Padding="3" 
                                                   Margin="6,0,0,0" 
                                                   ToolTip="Copier ce numéro de série" 
                                                   Command="{Binding DataContext.CopySerialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                   CommandParameter="{Binding SerialNumber}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Machine Status -->
                        <DataGridTemplateColumn Header="Statut" Width="1.0*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" 
                                            Margin="4">
                                        <TextBlock Text="{Binding StatusText}" 
                                                   Foreground="{Binding StatusColor}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TPM Certificate Status -->
                        <DataGridTemplateColumn Header="Certificat TPM" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" 
                                            Margin="4" 
                                            ToolTip="{Binding CertStatusText}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding CertExpirationColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CertStatusText}" 
                                                       Foreground="{Binding CertExpirationColor}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="10" 
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Registration Date -->
                        <DataGridTemplateColumn Header="Enregistré le" Width="1.1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RegisteredAtUtc, StringFormat='dd/MM/yyyy'}" 
                                               Foreground="#94A3B8" 
                                               FontSize="11" 
                                               VerticalAlignment="Center" 
                                               Margin="4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- TPM Certificate Status Legend -->
                <Border Grid.Row="1" 
                        Margin="0,8,0,0" 
                        Padding="8,6" 
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                        CornerRadius="6" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Certificats TPM :" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Valide (>30j)" FontSize="10" Foreground="#10B981" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Expire sous 30j" FontSize="10" Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Expiré / Révoqué" FontSize="10" Foreground="#EF4444" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <Ellipse Width="8" Height="8" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Non enrôlé" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT COLUMN: Cryptographic inspection panel for selected machine (Extracted component) -->
        <views:MachineInspectorControl Grid.Column="1"/>
    </Grid>

    <!-- FOOTER: Status bar -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="8,4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="{Binding OperatorStatusText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
        </DockPanel>
    </Border>

</Grid>
</Page>
