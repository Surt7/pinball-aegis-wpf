<Page x:Class="Pinball_Aegis.Views.ProvisionMachineView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:Pinball_Aegis.ViewModels"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=viewmodels:ProvisionMachineViewModel}"
      d:DesignHeight="700" d:DesignWidth="1100"
      Title="Provisioning Nouveau Flipper">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: Title & Context -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Provisioning de Flipper" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Enregistrement d'un nouveau flipper dans l'inventaire avec rattachement de licence et génération du premier jeton OTP." 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
        </StackPanel>

        <!-- MAIN BODY: Split between Form (Left) and Result / Guide (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Provisioning Form -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20"
                    Margin="0,0,16,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Informations Générales" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- Serial Number -->
                        <TextBlock Text="Numéro de Série World Pinball *" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Ex: WP-126" 
                                    Margin="0,0,0,14"/>

                        <!-- Display Name -->
                        <TextBlock Text="Nom d'Affichage du Flipper *" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Ex: MEDIEVAL-MADNESS-01" 
                                    Margin="0,0,0,14"/>

                        <!-- IP License Selection -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                            <ui:Button DockPanel.Dock="Right" 
                                       Icon="{ui:SymbolIcon ArrowSync16}" 
                                       Appearance="Transparent" 
                                       Padding="4" 
                                       ToolTip="Rafraîchir les licences" 
                                       Command="{Binding LoadLicensesCommand}"/>
                            <TextBlock Text="Licence IP / Modèle de Jeu *" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ComboBox ItemsSource="{Binding IpLicenses}" 
                                  SelectedItem="{Binding SelectedLicense}" 
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,14">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Slug, StringFormat='({0})'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Location (Optional) -->
                        <TextBlock Text="Emplacement Initial (Optionnel)" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Ex: Salle d'arcade Lyon Centre" 
                                    Margin="0,0,0,14"/>

                        <!-- Notes (Optional) -->
                        <TextBlock Text="Notes / Référence Usine (Optionnel)" FontSize="12" FontWeight="Medium" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="Commentaires de fabrication ou d'expédition..." 
                                    Height="70" 
                                    TextWrapping="Wrap" 
                                    AcceptsReturn="True"
                                    Margin="0,0,0,20"/>

                        <!-- Error Banner (if any) -->
                        <Border Background="#2D1515" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Submit Button -->
                        <ui:Button Content="Provisionner le Flipper" 
                                   Icon="{ui:SymbolIcon Add24}" 
                                   Appearance="Primary" 
                                   HorizontalAlignment="Stretch"
                                   Command="{Binding ProvisionCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT COLUMN: Result / Operational instructions -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="20">
                <Grid>
                    <!-- State 1: When not yet provisioned -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:SymbolIcon Symbol="Tv24" FontSize="44" Margin="0,0,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="Guide de Déploiement Usine" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Remplissez le formulaire pour enregistrer la machine dans l'inventaire fleet." Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,14" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" Width="380">
                            <StackPanel>
                                <TextBlock Text="1. La machine sera créée en statut 'PendingEnrollment'." FontSize="11" Margin="0,2"/>
                                <TextBlock Text="2. Un jeton OTP à usage unique sera généré automatiquement." FontSize="11" Margin="0,2"/>
                                <TextBlock Text="3. Transmettez ce jeton au technicien terrain ou au banc d'essai." FontSize="11" Margin="0,2"/>
                                <TextBlock Text="4. Dès que la puce TPM consomme ce jeton, le flipper devient actif." FontSize="11" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- State 2: When provisioned with success -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResult}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#10B981" FontSize="26" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Flipper Provisionné avec Succès !" FontSize="16" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Machine ID Card -->
                            <TextBlock Text="ID Machine (UUID Système) :" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                                <DockPanel LastChildFill="True">
                                    <ui:Button DockPanel.Dock="Right" 
                                               Icon="{ui:SymbolIcon Copy16}" 
                                               Appearance="Transparent" 
                                               Command="{Binding CopyMachineIdCommand}" 
                                               ToolTip="Copier cet UUID"/>
                                    <TextBlock Text="{Binding ResultMachineId}" 
                                               FontFamily="Consolas, monospace" 
                                               FontSize="12" 
                                               Foreground="#93C5FD" 
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <!-- Enrollment Token Card (Green Box) -->
                            <TextBlock Text="Jeton d'Enrôlement Flipper (OTP Usage Unique) :" FontSize="11" FontWeight="SemiBold" Foreground="#51CF66" Margin="0,0,0,4"/>
                            <Border Background="#1A2E1A" BorderBrush="#51CF66" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBox Text="{Binding ResultToken, Mode=OneWay}" 
                                             IsReadOnly="True" 
                                             FontFamily="Consolas, monospace" 
                                             FontSize="11" 
                                             Background="#0F172A" 
                                             Foreground="#F8FAFC"
                                             Padding="8" 
                                             Margin="0,0,0,10"/>
                                    <ui:Button Content="Copier le Jeton" 
                                               Icon="{ui:SymbolIcon Copy24}" 
                                               Appearance="Primary" 
                                               Command="{Binding CopyTokenCommand}" 
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Prochaine Étape :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Saisissez ce jeton dans le panneau de service du flipper ou injectez-le via le terminal Qt technicien pour déclencher la certification TPM." 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <ui:Button Content="Provisionner un Autre Flipper" 
                                       Icon="{ui:SymbolIcon ArrowReset24}" 
                                       Appearance="Secondary" 
                                       Command="{Binding ResetFormCommand}" 
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER: Status Bar -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="8,4" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
        </Border>
    </Grid>
</Page>
